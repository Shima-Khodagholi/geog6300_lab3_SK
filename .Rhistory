tm_polygons(fill="grey90")+
tm_shape(numbat_season %>% filter(season=="Spring"))+
tm_dots(size=0.4,fill="darkgreen",fill_alpha=0.5)+
tm_title("Spring")
map4
#All four together
tmap_arrange(map1,map2,map3,map4,ncol=2)
